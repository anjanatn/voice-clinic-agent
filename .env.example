# LiveKit Server Configuration (LiveKit Cloud or local livekit-server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Groq API Key (powers Whisper STT + Ultra-low-latency LLM)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# TTS Provider: "cartesia" or "deepgram"
TTS_PROVIDER=cartesia

# Cartesia API Key (ultra-low-latency Sonic TTS)
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE=a0e99841-438c-4a64-b679-ae501e7d6091

# Deepgram API Key (optional alternative TTS if TTS_PROVIDER=deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# FastAPI Backend Service URL
CLINIC_API_URL=http://127.0.0.1:8000
CLINIC_DB_PATH=clinic.db
